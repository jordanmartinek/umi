# PayPal API Credentials
# Get these from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# Security
JWT_SECRET=change-this-to-a-random-string-in-production

# Persistent storage (Upstash Redis)
# ----------------------------------------------------------------------------
# REQUIRED for the admin dashboard to persist on Vercel. Without these, the app
# falls back to the JSON files in data/ — fine for LOCAL dev, but on Vercel the
# filesystem is ephemeral so any product/order/settings change is LOST.
#
# On Vercel: add "Upstash for Redis" from the Marketplace (Storage tab) and
# these two vars are injected automatically — you don't need to set them here.
#
# For local dev against a real Redis, grab them from the Upstash console:
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here
