{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin/(.*)", "dest": "/public/admin/$1" },
    { "src": "/admin", "dest": "/public/admin/index.html" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|webp|svg|ico))", "dest": "/public/store/$1" },
    { "src": "/(.*)", "dest": "/public/store/index.html" }
  ]
}
